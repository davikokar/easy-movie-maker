{
  "name": "easy-movie-maker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^26.12.1",
    "pnpm": "^12.16.1"
  },
  "scripts": {
    "dev": "pnpm --filter @moviemaker/playground dev",
    "build": "pnpm --filter @moviemaker/playground build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:golden": "pnpm --filter @moviemaker/playground test:golden",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.10",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
